# Cloudflare Pages header rules — direct translation of the [[headers]]
# blocks in netlify.toml. Cloudflare Pages reads this file the same way
# Netlify does (Netlify's own _headers convention), so this is a straight
# port with no syntax changes.
#
# Drop this file in the repo root (same level as index.html) and it will be
# picked up automatically on the next Cloudflare Pages build.

# Data snapshots. Filenames carry a content hash, so a given URL can never
# change meaning and may be cached forever.
/snapshots/*
  Cache-Control: public, max-age=31536000, immutable

# Brand mark and favicons. Long cache with a revalidate rather than the
# immutable treatment reserved for hashed names.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# CSV mirrors of the sheets the other pages parse. Stable filenames, so
# these are revalidated rather than cached forever.
#
# WHY text/plain AND NOT text/csv
# Cloudflare picks what to compress off the Content-Type, against a fixed
# list, and text/csv is not on it. Served as text/csv these came down RAW --
# movies.csv 11.7MB, d2d.csv 1.27MB -- on every first visit, which silently
# undid the whole point of mirroring. build-data.mjs says the mirrors exist
# to get "a CDN with Brotli"; that was true on Netlify and quietly stopped
# being true here. text/plain IS on the list, so the same bytes now arrive
# Brotli'd. Nothing reads the Content-Type: every consumer is a
# fetch().text() handed to that page's own CSV parser.
/mirror/*
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: text/plain; charset=utf-8

# The pointer to the current snapshots. Must be re-checked every time or a
# rebuild would never be noticed.
/data-manifest.json
  Cache-Control: public, max-age=0, must-revalidate

# Pages themselves: always revalidate, but a 304 costs one round trip and
# no body.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
